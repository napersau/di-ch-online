CHUA_PORT=3001
CHUA_HOST=127.0.0.1
# Mật khẩu riêng của dự án này. Không đọc .env ở thư mục cha.
CHUA_ADMIN_TOKEN=
# Chỉ tự kết nối khi chạy npm run live / npm run chua:live.
CHUA_TIKTOK_USERNAME=
TIKTOK_SIGN_API_KEY=

# Tùy chọn: thư mục dữ liệu khi gắn ổ lưu trữ của hosting.
# DATA_DIR=/var/data
# Khi deploy, đặt NODE_ENV=production và CHUA_ADMIN_TOKEN dài ít nhất 32 ký tự.
# Render tự cấp PORT và RENDER_EXTERNAL_URL; PORT được ưu tiên khi production.
# PUBLIC_ORIGIN=https://ten-mien-cua-ban
# TRUST_PROXY=1 chỉ khi chạy sau reverse proxy của hosting.
